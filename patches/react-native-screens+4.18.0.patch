+        requireFragmentManager
+            .beginTransaction()
+            .setReorderingAllowed(true)
+            .apply {
+                if (oldFocusedTab != null) {
+                    this.remove(oldFocusedTab)
+                }
+                this.add(contentView.id, newFocusedTab)
