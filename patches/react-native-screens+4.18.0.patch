+    private fun getFragmentForMenuItemId(itemId: Int): TabScreenFragment? = tabScreenFragments.getOrNull(itemId)
+
+    private fun getSelectedTabScreenFragmentId(): Int? {
+        if (tabScreenFragments.isEmpty()) {
