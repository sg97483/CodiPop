rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /closet/{closetId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /recentResults/{resultId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /recentCodi/{resultId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /wishlist/{wishlistId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedCommunityPosts/{postId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /communityPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0;

      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'saveCount'])
      );

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /likes/{likeUserId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.uid == likeUserId;
      }
    }
  }
}
